{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "args": [
              "hook"
            ],
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/safescope"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "hook"
            ],
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/safescope"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "hook"
            ],
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/safescope"
          }
        ]
      }
    ]
  }
}
