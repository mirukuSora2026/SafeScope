{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "args": [
              "hook"
            ],
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/safescope.exe"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "hook"
            ],
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/safescope.exe"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "args": [
              "hook"
            ],
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/safescope.exe"
          }
        ]
      }
    ]
  }
}
